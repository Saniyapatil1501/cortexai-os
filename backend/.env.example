# Server
HOST=127.0.0.1
PORT=8000

# Database
DATABASE_URL=sqlite:///cortexai.db

# Gemini AI
# Get your API key from Google AI Studio
GEMINI_API_KEY=

# Optional OpenAI Fallback
OPENAI_API_KEY=

# Clerk Backend Verification
# CLERK_ISSUER can be found in Clerk Dashboard -> API Keys -> Advanced -> Issuer URL
CLERK_ISSUER=
# CLERK_JWKS_URL can be constructed as CLERK_ISSUER + /.well-known/jwks.json
CLERK_JWKS_URL=

# Optional Future Services
SENTRY_DSN=
