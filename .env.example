# Clerk Frontend Auth
# Get your Publishable Key from Clerk Dashboard -> API Keys
VITE_CLERK_PUBLISHABLE_KEY=

# Frontend API URL (points to local FastAPI backend daemon by default)
VITE_API_URL=http://127.0.0.1:8000/api

# Production Mode
NODE_ENV=development

# Sentry DSN for frontend error monitoring
VITE_SENTRY_DSN=
